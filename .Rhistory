## Pull legend for combined plot
get_legend <- function(plot) {
g <- ggplotGrob(plot)
legend <- g$grobs[sapply(g$grobs, function(x) x$name) == "guide-box"]
legend[[1]]
}
legend <- get_legend(ad_mets)
ad_mets <- ad_mets + theme(legend.position = "none")
