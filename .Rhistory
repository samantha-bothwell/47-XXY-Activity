sumdata_sleep <- read_csv(here::here("data-clean", "NonAggregated1minSleep_cleaned.csv"))
View(sumdata_day)
act_sum <- sumdata_day %>%
group_by(ID, date) %>%
summarise(mean_mets = mean(met_minute)) %>%
ungroup()
View(act_sum)
View(sumdata_sleep)
