## Code bouts
activity_pca_night <- sumdata_day %>%
mutate(activity_level = case_when(met_minute >= 3 ~ "Moderate-to-Vigorous Activity",
met_minute > 1.25 ~ "Light Activity",
met_minute == 1.25 ~ "Sedentary"))
View(activity_pca_night)
## Code bouts
activity_pca <- sumdata_day %>%
mutate(activity_level = case_when(met_minute >= 3 ~ "Moderate-to-Vigorous Activity",
met_minute >= 1.5 ~ "Light Activity",
met_minute < 1.5 ~ "Sedentary")) %>%
group_by(ID, date) %>%
mutate(change = ifelse(lag(activity_level) != activity_level, "Yes", "No"),
change = replace_na(change, "Yes"),
bout_id = cumsum(change == "Yes")) %>%
ungroup() %>%
group_by(ID, date, bout_id) %>%
mutate(bout_length = n()) %>%
ungroup() %>%
# average within night and ID
group_by(ID, group, date) %>%
summarise(hours_mvpa = sum(state_mix == "Moderate-to-Vigorous Activity")/60,
hours_light = sum(state_mix == "Light Activity")/60,
mean_bout_quiet = mean(bout_length[state_mix == "Moderate-to-Vigorous Activity" & change == "Yes"]),
mean_bout_restless = mean(bout_length[state_mix == "Light Activity" & change == "Yes"])) %>%
ungroup()
